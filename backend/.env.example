# ==============================================================================
# PhishSentinel Multi-Agent Fraud Detection Platform - Environment Configuration
# ==============================================================================

# API Configuration
PROJECT_NAME="PhishSentinel"
VERSION="1.0.0"
ENVIRONMENT="development"  # set to "production" to require a real SECRET_KEY

# Security & Authentication
SECRET_KEY="replace-with-a-secure-32-character-random-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REQUIRE_AUTH=false
DEFAULT_ANALYST_PASSWORD="CyberGuard2026!"

# Abuse limits
MAX_UPLOAD_BYTES=5242880
RATE_LIMIT_PER_MINUTE=30

# Groq AI Layer (Optional - system operates with full deterministic & ML engine if absent)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Database Connection (Default SQLite, compatible with PostgreSQL)
# Leave unset to use backend/cybersecurity_platform.db regardless of CWD.
# DATABASE_URL="sqlite:///backend/cybersecurity_platform.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/phishsentinel_db"

# Policy Thresholds (Configurable bands 0-100; persisted via /api/settings)
THRESHOLD_LOW_MAX=19
THRESHOLD_MODERATE_MAX=39
THRESHOLD_HIGH_MAX=69
THRESHOLD_CRITICAL_MIN=70
